# Environment
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saferoute_db
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# One-time administrator bootstrap (only used by npm run seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_a_12_character_minimum_password
SEED_ADMIN_PHONE=9999999999

# Email (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Upload
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE=5242880
MAX_PROFILE_IMAGE_SIZE=2097152

# Frontend
FRONTEND_URL=http://localhost:5173

# Rate Limiting
# Global rate limit window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Global maximum requests per window per IP (default: 1000)
RATE_LIMIT_MAX=1000
# Sensitive authentication routes max failed attempts per window per IP (default: 10)
AUTH_RATE_LIMIT_MAX=10

# Reverse Proxy Configuration (optional)
# If running behind a reverse proxy in production (e.g. Nginx, Cloudflare, AWS ALB),
# set TRUST_PROXY=1 in Express (or configure app.set('trust proxy', 1)) so express-rate-limit detects client IPs accurately.
# TRUST_PROXY=1
